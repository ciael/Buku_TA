<mxfile host="app.diagrams.net">
  <diagram name="Alur Pengambilan Data" id="metode-ambil-data">
    <mxGraphModel dx="1100" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="580" pageHeight="750" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===== KOLOM 1 (kiri, center-x ≈ 140) ===== -->

        <!-- MULAI -->
        <mxCell id="n1" parent="1" value="MULAI" vertex="1"
          style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;">
          <mxGeometry x="90" y="20" width="100" height="45" as="geometry" />
        </mxCell>

        <!-- B_in connector (kiri dari "Atur kondisi keran") -->
        <mxCell id="n7" parent="1" value="B" vertex="1"
          style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;aspect=fixed;">
          <mxGeometry x="0" y="128" width="40" height="40" as="geometry" />
        </mxCell>

        <!-- Atur kondisi keran -->
        <mxCell id="n2" parent="1" vertex="1"
          value="&lt;b&gt;Atur kondisi keran&lt;/b&gt;&lt;br&gt;(0–4, bebas dan gangguan)"
          style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;">
          <mxGeometry x="45" y="115" width="190" height="65" as="geometry" />
        </mxCell>

        <!-- Baca tekanan air -->
        <mxCell id="n3" parent="1" vertex="1"
          value="&lt;b&gt;Baca tekanan air&lt;/b&gt;&lt;br&gt;(sensor)"
          style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;">
          <mxGeometry x="45" y="240" width="190" height="55" as="geometry" />
        </mxCell>

        <!-- Diamond: Tekanan = 0,30 bar? -->
        <mxCell id="n4" parent="1" vertex="1"
          value="Tekanan&lt;br&gt;= 0,30 bar?"
          style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;">
          <mxGeometry x="45" y="355" width="190" height="80" as="geometry" />
        </mxCell>

        <!-- Ubah duty cycle -->
        <mxCell id="n5" parent="1" vertex="1"
          value="&lt;b&gt;Ubah &lt;i&gt;duty cycle&lt;/i&gt;&lt;/b&gt;&lt;br&gt;naik bila &lt; 0,30 bar&lt;br&gt;turun bila &gt; 0,30 bar&lt;br&gt;(batas 70–95%)"
          style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;">
          <mxGeometry x="45" y="500" width="190" height="90" as="geometry" />
        </mxCell>

        <!-- A_out connector (bawah kolom 1) -->
        <mxCell id="n6" parent="1" value="A" vertex="1"
          style="ellipse;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;aspect=fixed;">
          <mxGeometry x="115" y="655" width="50" height="50" as="geometry" />
        </mxCell>

        <!-- ===== KOLOM 2 (kanan, center-x ≈ 405) ===== -->

        <!-- A_in connector (atas kolom 2) -->
        <mxCell id="n8" parent="1" value="A" vertex="1"
          style="ellipse;whiteSpace=wrap;html=1;fontSize=13;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;aspect=fixed;">
          <mxGeometry x="380" y="20" width="50" height="50" as="geometry" />
        </mxCell>

        <!-- Tekanan stabil, simpan data -->
        <mxCell id="n9" parent="1" vertex="1"
          value="&lt;b&gt;Tekanan stabil&lt;/b&gt;&lt;br&gt;(&lt;i&gt;error&lt;/i&gt;, &amp;#916;&lt;i&gt;error&lt;/i&gt;, &lt;i&gt;duty&lt;/i&gt;)&lt;br&gt;simpan data"
          style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;">
          <mxGeometry x="320" y="130" width="170" height="75" as="geometry" />
        </mxCell>

        <!-- Diamond: Coba kondisi keran lain? -->
        <mxCell id="n10" parent="1" vertex="1"
          value="Coba kondisi&lt;br&gt;keran lain?"
          style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;">
          <mxGeometry x="320" y="265" width="170" height="80" as="geometry" />
        </mxCell>

        <!-- STOP -->
        <mxCell id="n11" parent="1" value="&lt;b&gt;STOP&lt;/b&gt;&lt;br&gt;Pengumpulan Dataset" vertex="1"
          style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;">
          <mxGeometry x="345" y="415" width="120" height="55" as="geometry" />
        </mxCell>

        <!-- B_out connector (kanan dari "Coba kondisi keran lain?") -->
        <mxCell id="n12" parent="1" value="B" vertex="1"
          style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;aspect=fixed;">
          <mxGeometry x="510" y="275" width="40" height="40" as="geometry" />
        </mxCell>

        <!-- ===== EDGES ===== -->

        <!-- n1 (MULAI) → n2 (Atur kondisi keran) -->
        <mxCell id="e1" edge="1" source="n1" target="n2" parent="1"
          style="endArrow=block;endFill=1;html=1;rounded=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- n7 (B_in) → n2 (Atur kondisi keran) -->
        <mxCell id="e11" edge="1" source="n7" target="n2" parent="1"
          style="endArrow=block;endFill=1;html=1;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- n2 (Atur kondisi keran) → n3 (Baca tekanan air) -->
        <mxCell id="e2" edge="1" source="n2" target="n3" parent="1"
          style="endArrow=block;endFill=1;html=1;rounded=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- n3 (Baca tekanan air) → n4 (diamond tekanan) -->
        <mxCell id="e3" edge="1" source="n3" target="n4" parent="1"
          style="endArrow=block;endFill=1;html=1;rounded=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- n4 "Tidak" (bawah) → n5 (Ubah duty cycle) -->
        <mxCell id="e4" edge="1" source="n4" target="n5" parent="1"
          style="endArrow=block;endFill=1;html=1;rounded=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"
          value="Tidak">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" x="-15" y="0" />
          </mxGeometry>
        </mxCell>

        <!-- n5 (Ubah duty cycle) → n3 (Baca tekanan air) via kiri, label "Ulang setiap 3 dtk" -->
        <mxCell id="e5" edge="1" source="n5" target="n3" parent="1"
          style="endArrow=block;endFill=1;html=1;rounded=0;exitX=0;exitY=0.5;entryX=0;entryY=0.5;"
          value="Ulang setiap 3 dtk">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="18" y="545" />
              <mxPoint x="18" y="267" />
            </Array>
            <mxPoint as="offset" x="-50" y="0" />
          </mxGeometry>
        </mxCell>

        <!-- n4 "Ya" (kanan) → n6 (A_out) via kanan lalu bawah -->
        <mxCell id="e6" edge="1" source="n4" target="n6" parent="1"
          style="endArrow=block;endFill=1;html=1;rounded=0;exitX=1;exitY=0.5;entryX=0.5;entryY=0;"
          value="Ya">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="270" y="395" />
              <mxPoint x="270" y="680" />
              <mxPoint x="165" y="680" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- n8 (A_in) → n9 (Tekanan stabil) -->
        <mxCell id="e7" edge="1" source="n8" target="n9" parent="1"
          style="endArrow=block;endFill=1;html=1;rounded=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- n9 (Tekanan stabil) → n10 (diamond coba keran) -->
        <mxCell id="e8" edge="1" source="n9" target="n10" parent="1"
          style="endArrow=block;endFill=1;html=1;rounded=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- n10 "Tidak" (bawah) → n11 (STOP) -->
        <mxCell id="e9" edge="1" source="n10" target="n11" parent="1"
          style="endArrow=block;endFill=1;html=1;rounded=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"
          value="Tidak">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" x="-15" y="0" />
          </mxGeometry>
        </mxCell>

        <!-- n10 "Ya" (kanan) → n12 (B_out) -->
        <mxCell id="e10" edge="1" source="n10" target="n12" parent="1"
          style="endArrow=block;endFill=1;html=1;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"
          value="Ya">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
