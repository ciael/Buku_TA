<mxfile host="app.diagrams.net" type="device">
  <diagram id="diagram-alir-penelitian" name="Diagram Alir Penelitian">
    <mxGraphModel dx="900" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="720" pageHeight="640" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===== NODE kiri ===== -->
        <mxCell id="mulai" value="Mulai" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="90" y="20" width="160" height="46" as="geometry" />
        </mxCell>

        <mxCell id="desain" value="Pembuatan Desain&#10;Rangkaian PWM AC&#10;&lt;i&gt;Chopper&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="70" y="110" width="200" height="72" as="geometry" />
        </mxCell>

        <mxCell id="simulasi" value="Simulasi Rangkaian&#10;PWM AC &lt;i&gt;Chopper&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="70" y="222" width="200" height="58" as="geometry" />
        </mxCell>

        <mxCell id="realisasi" value="Merealisasikan&#10;rangkaian dan instalasi&#10;pompa air" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="70" y="320" width="200" height="72" as="geometry" />
        </mxCell>

        <mxCell id="ambildata" value="Pengambilan data&#10;untuk melatih &lt;i&gt;Neural Network&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="70" y="432" width="200" height="70" as="geometry" />
        </mxCell>

        <!-- ===== NODE kanan ===== -->
        <mxCell id="kumpuldata" value="Pengumpulan data hasil&#10;uji rangkaian PWM AC&#10;&lt;i&gt;Chopper&lt;/i&gt; dengan kontrol&#10;&lt;i&gt;Neural Network&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="440" y="105" width="205" height="95" as="geometry" />
        </mxCell>

        <mxCell id="banding" value="Membandingkan&#10;data hasil uji rangkaian&#10;dengan &lt;i&gt;setpoint&lt;/i&gt;" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="448" y="250" width="190" height="120" as="geometry" />
        </mxCell>

        <mxCell id="analisa" value="Analisa hasil dan&#10;evaluasi" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="442" y="432" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="selesai" value="Selesai" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="462" y="545" width="160" height="46" as="geometry" />
        </mxCell>

        <!-- ===== EDGE ===== -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;" edge="1" parent="1" source="mulai" target="desain">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;" edge="1" parent="1" source="desain" target="simulasi">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;" edge="1" parent="1" source="simulasi" target="realisasi">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;" edge="1" parent="1" source="realisasi" target="ambildata">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ambildata -> kumpuldata (maju, naik ke kanan atas) -->
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ambildata" target="kumpuldata">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="355" y="467" />
              <mxPoint x="355" y="60" />
              <mxPoint x="542" y="60" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- kumpuldata -> banding -->
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="kumpuldata" target="banding">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- banding -> analisa (Ya) -->
        <mxCell id="e7" value="Ya" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=11;" edge="1" parent="1" source="banding" target="analisa">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- analisa -> selesai -->
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;" edge="1" parent="1" source="analisa" target="selesai">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- banding -> ambildata (Tidak, umpan balik) -->
        <mxCell id="e9" value="Tidak" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#000000;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;fontSize=11;" edge="1" parent="1" source="banding" target="ambildata">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="400" y="310" />
              <mxPoint x="400" y="555" />
              <mxPoint x="170" y="555" />
            </Array>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
