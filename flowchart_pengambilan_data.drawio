        <mxCell id="c2" style="endArrow=none;html=1;dashed=1;strokeColor=#b85450;" edge="1" parent="1" source="noteSat" target="clamp"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="c3" style="endArrow=none;html=1;dashed=1;strokeColor=#d6b656;" edge="1" parent="1" source="noteScenario" target="episode"><mxGeometry relative="1" as="geometry" /></mxCell>

