        <!-- konektor catatan -->
        <mxCell id="lnRule" style="endArrow=none;html=1;dashed=1;strokeColor=#d6b656;" edge="1" parent="1" source="noteRule" target="deltaduty"><mxGeometry relative="1" as="geometry" /></mxCell>

      </root>
